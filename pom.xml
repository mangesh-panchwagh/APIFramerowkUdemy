<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>APIFrameworkUdemy</groupId>
	<artifactId>APIFrameworkUdemy</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<build>
    <plugins>

        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.5.4</version>
            <configuration>
                <testFailureIgnore>true</testFailureIgnore>
            </configuration>
        </plugin>

        <plugin>
            <groupId>net.masterthought</groupId>
            <artifactId>maven-cucumber-reporting</artifactId>
            <version>5.10.2</version>

            <executions>
                <execution>
                    <id>execution</id>
                    <phase>verify</phase>

                    <goals>
                        <goal>generate</goal>
                    </goals>

                    <configuration>

                        <projectName>APIFrameworkUdemy</projectName>

                        <skip>false</skip>

                        <outputDirectory>
                            ${project.build.directory}/cucumber-report
                        </outputDirectory>

                        <inputDirectory>
                            ${project.build.directory}/jsonReports
                        </inputDirectory>

                        <jsonFiles>
                            <param>**/*.json</param>
                        </jsonFiles>

                        <mergeFeaturesById>false</mergeFeaturesById>

                        <mergeFeaturesWithRetest>false</mergeFeaturesWithRetest>

                        <checkBuildResult>false</checkBuildResult>

                    </configuration>
                </execution>
            </executions>

        </plugin>

    </plugins>
</build>
	<dependencies>
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<version>7.12.0</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.cucumber</groupId>
			<artifactId>cucumber-java</artifactId>
			<version>7.34.7</version>
		</dependency>
		<dependency>
			<groupId>io.rest-assured</groupId>
			<artifactId>rest-assured</artifactId>
			<version>6.0.1</version>
		</dependency>
		<dependency>
			<groupId>io.cucumber</groupId>
			<artifactId>cucumber-testng</artifactId>
			<version>7.34.7</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>3.2.2</version>
		</dependency>

